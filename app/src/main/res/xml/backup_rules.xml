<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de backup para API 23-30 (fullBackupContent).
     Excluye la base de datos y las portadas locales del backup ADB y nube. -->
<full-backup-content>
    <exclude domain="database" path="scanbook_database" />
    <exclude domain="database" path="scanbook_database-shm" />
    <exclude domain="database" path="scanbook_database-wal" />
    <exclude domain="file" path="covers/" />
</full-backup-content>
