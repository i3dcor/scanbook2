<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de extracción de datos para API 31+ (dataExtractionRules).
     Excluye la base de datos y las portadas locales del backup en nube
     y de las transferencias entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="scanbook_database" />
        <exclude domain="database" path="scanbook_database-shm" />
        <exclude domain="database" path="scanbook_database-wal" />
        <exclude domain="file" path="covers/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="scanbook_database" />
        <exclude domain="database" path="scanbook_database-shm" />
        <exclude domain="database" path="scanbook_database-wal" />
        <exclude domain="file" path="covers/" />
    </device-transfer>
</data-extraction-rules>
